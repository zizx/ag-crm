{
  "manifest_version": 3,
  "name": "AG CRM Lead Capture",
  "version": "0.8.0",
  "description": "Capture visible lead details from web pages and save them to AG CRM.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:3210/*",
    "http://localhost:3210/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": [
        "shared/crm-api.js",
        "shared/site-settings.js",
        "shared/adapters.js",
        "extract-lead.js",
        "content-script.js"
      ],
      "css": ["page-ui.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Save lead to AG CRM",
    "default_popup": "popup.html"
  }
}
